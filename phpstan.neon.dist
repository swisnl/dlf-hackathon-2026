includes:
    - ./vendor/larastan/larastan/extension.neon
    - ./vendor/nesbot/carbon/extension.neon
    - ./vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - ./vendor/swisnl/phpstan-bitbucket/extension.neon

parameters:
    paths:
        - app
        - config
        - database
    level: max
    tmpDir: .phpstan.cache
